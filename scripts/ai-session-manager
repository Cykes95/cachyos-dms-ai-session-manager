#!/usr/bin/env python3
"""Metadata-only, isolated terminal profiles for AI CLIs."""
import argparse, json, os, select, shutil, ssl, subprocess, sys, tempfile, time
from datetime import datetime, timezone
from pathlib import Path
from urllib.error import URLError
from urllib.request import Request, urlopen
from uuid import uuid4

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ai-session-manager" / "sessions.json"
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "ai-session-manager"
CACHE = DATA / "usage.json"
AGY_TOKEN = Path.home() / ".gemini" / "antigravity-cli" / "antigravity-oauth-token"

def defaults():
    return {"activeId": "codex-1", "sessions": [
        {"id": "codex-1", "label": "Codex 1", "provider": "codex"},
        {"id": "codex-2", "label": "Codex 2", "provider": "codex"},
        {"id": "antigravity-1", "label": "Antigravity", "provider": "agy"}]}

def load():
    try: data = json.loads(CONFIG.read_text())
    except (OSError, json.JSONDecodeError): data = defaults()
    return data

def save(data):
    CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=CONFIG.parent, delete=False) as f:
        json.dump(data, f, separators=(",", ":")); f.write("\n"); name = f.name
    os.chmod(name, 0o600); os.replace(name, CONFIG)

def save_cache(data):
    DATA.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=DATA, delete=False) as f:
        json.dump(data, f, separators=(",", ":")); f.write("\n"); name = f.name
    os.chmod(name, 0o600); os.replace(name, CACHE)

def load_cache():
    try:
        data = json.loads(CACHE.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError): return {}

def session(data, ident):
    for item in data["sessions"]:
        if item["id"] == ident: return item
    raise SystemExit("Unknown session: " + ident)

def codex_command():
    override = os.environ.get("AI_SESSION_MANAGER_CODEX")
    if override: return [override]
    standalone = Path.home() / ".codex" / "packages" / "standalone" / "current" / "bin" / "codex"
    if standalone.is_file(): return [str(standalone)]
    for candidate in ["/usr/bin/codex", "/usr/local/bin/codex"]:
        if Path(candidate).is_file(): return [candidate]
    if shutil.which("mise"): return ["mise", "x", "codex", "--", "codex"]
    found = shutil.which("codex")
    if found: return [found]
    raise SystemExit("Codex CLI not found; install it or set AI_SESSION_MANAGER_CODEX")

def command(item, login=False):
    if item["provider"] == "codex":
        home = DATA / "codex" / item["id"]; home.mkdir(mode=0o700, parents=True, exist_ok=True)
        env = os.environ.copy(); env["CODEX_HOME"] = str(home)
        return codex_command() + (["login"] if login else []), env
    binary = shutil.which("agy")
    if not binary: raise SystemExit("agy is not installed")
    return [binary, "--dangerously-skip-permissions"], os.environ.copy()

def codex_usage(item):
    if item["provider"] != "codex": return agy_usage()
    home = DATA / "codex" / item["id"]
    if not (home / "auth.json").is_file(): return {"status": "Inicia sesión para ver los límites", "limits": []}
    env = os.environ.copy(); env["CODEX_HOME"] = str(home)
    process = None
    try:
        process = subprocess.Popen(codex_command() + ["-s", "read-only", "-a", "never", "app-server", "--stdio"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env)
        assert process.stdin and process.stdout
        process.stdin.write(json.dumps({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "ai-session-manager", "version": "0.1"}}}) + "\n")
        process.stdin.write(json.dumps({"method": "initialized", "params": {}}) + "\n"); process.stdin.flush()
        process.stdin.write(json.dumps({"id": 2, "method": "account/rateLimits/read", "params": {}}) + "\n"); process.stdin.flush()
        deadline = time.monotonic() + 6
        while time.monotonic() < deadline:
            ready, _, _ = select.select([process.stdout], [], [], 0.2)
            if not ready: continue
            response = json.loads(process.stdout.readline())
            if response.get("id") != 2: continue
            rate = response.get("result", {}).get("rateLimits", {})
            limits = []
            for label, key in (("Sesión", "primary"), ("Semanal", "secondary")):
                window = rate.get(key, {})
                used = window.get("usedPercent")
                if isinstance(used, (int, float)):
                    reset = window.get("resetsAt")
                    reset_text = ""
                    if isinstance(reset, (int, float)):
                        reset_text = datetime.fromtimestamp(reset, timezone.utc).astimezone().strftime("%d %b · %H:%M")
                    limits.append({"label": label, "used": round(used), "reset": reset_text, "resetAt": int(reset * 1000) if isinstance(reset, (int, float)) else 0})
            credits = []
            for credit in response.get("result", {}).get("rateLimitResetCredits", {}).get("credits", []):
                if credit.get("status") != "available": continue
                expiry = credit.get("expiresAt")
                expiry_text = ""
                if isinstance(expiry, (int, float)):
                    expiry_text = datetime.fromtimestamp(expiry, timezone.utc).astimezone().strftime("%d %b · %H:%M")
                credit_id = str(credit.get("id") or "")
                if credit_id: credits.append({"id": credit_id, "title": str(credit.get("title") or "Reiniciar límites"), "expires": expiry_text})
            reset_summary = response.get("result", {}).get("rateLimitResetCredits", {})
            return {"status": str(rate.get("planType") or "Plan de Codex"), "limits": limits, "resetCredits": credits, "availableResetCount": int(reset_summary.get("availableCount") or len(credits))}
    except (OSError, ValueError, json.JSONDecodeError):
        return {"status": "No se pudieron actualizar los límites", "limits": []}
    finally:
        if process:
            process.terminate()
            try: process.wait(timeout=1)
            except subprocess.TimeoutExpired: process.kill()
    return {"status": "No se pudieron actualizar los límites", "limits": []}

def agy_ports():
    owners = set()
    for item in Path("/proc").iterdir():
        if not item.name.isdecimal(): continue
        try: name = (item / "comm").read_text().strip().lower()
        except OSError: continue
        # The CLI, desktop app and IDE extension do not always use the same
        # process name.  Keep the exact names for the common case, then accept
        # an Antigravity-specific command line for versions that rename the
        # language-server process.
        is_antigravity = name in {"agy", "antigravity", "language_server"}
        if not is_antigravity:
            try:
                command_line = (item / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="ignore").lower()
                is_antigravity = "antigravity" in command_line
            except OSError: pass
        if not is_antigravity: continue
        try:
            for fd in (item / "fd").iterdir():
                target = os.readlink(fd)
                if target.startswith("socket:[") and target.endswith("]"): owners.add(target[8:-1])
        except OSError: continue
    ports = set()
    for table in (Path("/proc/net/tcp"), Path("/proc/net/tcp6")):
        try: lines = table.read_text().splitlines()[1:]
        except OSError: continue
        for line in lines:
            fields = line.split()
            if len(fields) < 10 or fields[3] != "0A" or fields[9] not in owners: continue
            host, port = fields[1].split(":")
            if host in {"0100007F", "00000000000000000000000001000000"}: ports.add(int(port, 16))
    return sorted(ports, reverse=True)

def agy_post(base, method, body):
    payload = json.dumps(body).encode()
    request = Request(base.rstrip("/") + "/" + method, data=payload, headers={"Content-Type": "application/json", "Connect-Protocol-Version": "1"}, method="POST")
    # The CLI uses a self-signed certificate for its private localhost HTTPS
    # endpoint. This context is deliberately scoped to 127.0.0.1 probes.
    context = ssl._create_unverified_context() if base.startswith("https://127.0.0.1:") else None
    with urlopen(request, timeout=2, context=context) as response:
        data = json.loads(response.read().decode())
    return data if isinstance(data, dict) else {}

def agy_usage_from_local_server():
    metadata = {"metadata": {"ideName": "antigravity", "extensionName": "antigravity", "locale": "en", "ideVersion": "unknown"}}
    for port in agy_ports():
        status = summary = None
        # agy 1.2 exposes both an HTTP and an HTTPS listener. Earlier
        # releases used HTTP only, while the richer endpoint is HTTPS now.
        for scheme in ("https", "http"):
            base = f"{scheme}://127.0.0.1:{port}"
            try:
                summary = agy_post(base, "exa.language_server_pb.LanguageServerService/RetrieveUserQuotaSummary", {"forceRefresh": True})
                status = agy_post(base, "exa.language_server_pb.LanguageServerService/GetUserStatus", metadata)
                break
            except (OSError, URLError, ValueError, json.JSONDecodeError, ssl.SSLError): continue
        if status is None or summary is None: continue
        tier = ((status.get("userStatus") or {}).get("userTier") or {})
        plan = str(tier.get("name") or tier.get("description") or "Antigravity")
        groups = (summary.get("response") or summary).get("groups") or []
        limits = []
        for group in groups:
            name = str(group.get("displayName") or group.get("name") or "Antigravity")
            for bucket in (group.get("buckets") or group.get("windows") or []):
                remaining = bucket.get("remainingFraction")
                if not isinstance(remaining, (int, float)) or not 0 <= remaining <= 1: continue
                reset_at = 0
                raw_reset = bucket.get("resetsAt") or bucket.get("resetTime") or bucket.get("resetAt") or ""
                if isinstance(raw_reset, str) and raw_reset:
                    try: reset_at = int(datetime.fromisoformat(raw_reset.replace("Z", "+00:00")).timestamp() * 1000)
                    except ValueError: pass
                limits.append({"label": name + " · " + str(bucket.get("label") or bucket.get("window") or bucket.get("name") or "Cuota"), "used": round((1 - remaining) * 100), "reset": "", "resetAt": reset_at})
        return {"status": plan if limits else "La cuota de Antigravity no está disponible", "limits": limits, "resetCredits": [], "source": "local", "updatedAt": int(time.time() * 1000)}
    return None

def agy_remote_post(method, token, body, user_agent="antigravity"):
    request = Request("https://cloudcode-pa.googleapis.com/v1internal:" + method, data=json.dumps(body).encode(), headers={"Authorization": "Bearer " + token, "Content-Type": "application/json", "User-Agent": user_agent}, method="POST")
    with urlopen(request, timeout=8) as response:
        data = json.loads(response.read().decode())
    return data if isinstance(data, dict) else {}

def agy_remote_usage():
    # Reuse agy's official OAuth session without copying it into this plugin.
    # A user can renew it through the existing Login action when it expires.
    try:
        credentials = json.loads(AGY_TOKEN.read_text())
        token = credentials.get("token", {}).get("access_token")
        if not isinstance(token, str) or not token: return None
        code_assist = agy_remote_post("loadCodeAssist", token, {"metadata": {"ideType": "ANTIGRAVITY", "platform": "PLATFORM_UNSPECIFIED", "pluginType": "GEMINI"}})
        project = code_assist.get("cloudaicompanionProject")
        models = agy_remote_post("fetchAvailableModels", token, {"project": project} if isinstance(project, str) and project else {})
    except (OSError, URLError, ValueError, json.JSONDecodeError):
        return None

    buckets = []
    for model_id, model in (models.get("models") or {}).items():
        if not isinstance(model, dict): continue
        quota = model.get("quotaInfo") or {}
        remaining = quota.get("remainingFraction")
        if not isinstance(remaining, (int, float)) or not 0 <= remaining <= 1: continue
        display = str(model.get("displayName") or model_id)
        # Image/autocomplete models are separate features rather than the
        # interactive agent quota represented by this widget.
        lowered = (str(model_id) + " " + display).lower()
        if "image" in lowered or model_id.startswith(("tab_", "chat_")): continue
        raw_reset = quota.get("resetTime") or ""
        reset_at = 0
        if isinstance(raw_reset, str) and raw_reset:
            try: reset_at = int(datetime.fromisoformat(raw_reset.replace("Z", "+00:00")).timestamp() * 1000)
            except ValueError: pass
        buckets.append({"label": display, "used": round((1 - remaining) * 100), "reset": "", "resetAt": reset_at, "remaining": remaining})

    if not buckets: return None
    # Several aliases share one quota. Keep the most restrictive model for
    # each identical quota window so the panel stays readable and truthful.
    distinct = {}
    for bucket in buckets:
        key = (bucket["used"], bucket["resetAt"])
        if key not in distinct or bucket["label"] < distinct[key]["label"]: distinct[key] = bucket
    limits = sorted(distinct.values(), key=lambda item: (item["used"], item["label"]), reverse=True)
    for item in limits: item.pop("remaining", None)
    tier = code_assist.get("currentTier") or code_assist.get("paidTier") or {}
    plan = str(tier.get("name") or tier.get("description") or "Antigravity") if isinstance(tier, dict) else str(tier or "Antigravity")
    return {"status": plan, "limits": limits, "resetCredits": [], "source": "oauth", "updatedAt": int(time.time() * 1000)}

def agy_cli_usage():
    """Read agy's native quota command without opening a visible terminal."""
    binary = shutil.which("agy")
    if not binary: return None
    try:
        process = subprocess.run([binary, "--print", "/usage", "--output-format", "json", "--print-timeout", "20s"], capture_output=True, text=True, timeout=25)
        payload = json.loads(process.stdout)
        groups = ((payload.get("command") or {}).get("data") or {}).get("groups") or []
    except (OSError, subprocess.TimeoutExpired, ValueError, json.JSONDecodeError):
        return None

    limits = []
    for group in groups:
        group_name = str(group.get("name") or "Antigravity")
        buckets = group.get("buckets") or []
        buckets = sorted(buckets, key=lambda bucket: 0 if str(bucket.get("window") or "").lower() in {"5h", "session"} else 1)
        for bucket in buckets:
            remaining = bucket.get("remaining_fraction")
            if not isinstance(remaining, (int, float)) or not 0 <= remaining <= 1: continue
            raw_reset = bucket.get("reset_time") or ""
            reset_at = 0
            if isinstance(raw_reset, str) and raw_reset:
                try: reset_at = int(datetime.fromisoformat(raw_reset.replace("Z", "+00:00")).timestamp() * 1000)
                except ValueError: pass
            window = str(bucket.get("window") or "").lower()
            window_name = "Sesión" if window in {"5h", "session"} else "Semana" if window == "weekly" else str(bucket.get("name") or "Cuota")
            limits.append({"label": group_name + " · " + window_name, "used": round((1 - remaining) * 100), "reset": "", "resetAt": reset_at})
    if not limits: return None
    return {"status": "Antigravity", "limits": limits, "resetCredits": [], "source": "agy-cli", "updatedAt": int(time.time() * 1000)}

def agy_usage():
    # Native /usage preserves the complete Session + Weekly breakdown without
    # opening a terminal window or starting an agent turn.
    result = agy_cli_usage()
    if result: return result
    result = agy_usage_from_local_server()
    if result: return result
    result = agy_remote_usage()
    if result: return result
    return {"status": "Inicia sesión en Antigravity para actualizar su cuota", "limits": [], "resetCredits": [], "source": "unavailable"}

def consume_reset(item, credit_id):
    if item["provider"] != "codex": raise SystemExit("Reset credits are only available for Codex")
    home = DATA / "codex" / item["id"]
    if not (home / "auth.json").is_file(): raise SystemExit("Sign in to this Codex profile first")
    env = os.environ.copy(); env["CODEX_HOME"] = str(home)
    process = None
    try:
        process = subprocess.Popen(codex_command() + ["-s", "read-only", "-a", "never", "app-server", "--stdio"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env)
        assert process.stdin and process.stdout
        process.stdin.write(json.dumps({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "ai-session-manager", "version": "0.1"}}}) + "\n")
        process.stdin.write(json.dumps({"method": "initialized", "params": {}}) + "\n")
        process.stdin.write(json.dumps({"id": 2, "method": "account/rateLimitResetCredit/consume", "params": {"creditId": credit_id, "idempotencyKey": str(uuid4())}}) + "\n"); process.stdin.flush()
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            ready, _, _ = select.select([process.stdout], [], [], 0.2)
            if not ready: continue
            response = json.loads(process.stdout.readline())
            if response.get("id") != 2: continue
            if response.get("error"): raise SystemExit("Codex rejected the reset credit")
            return
        raise SystemExit("Codex did not confirm the reset credit")
    finally:
        if process:
            process.terminate()
            try: process.wait(timeout=1)
            except subprocess.TimeoutExpired: process.kill()

def ensure_cli_wrapper():
    local_bin = Path.home() / ".local" / "bin"
    local_bin.mkdir(mode=0o755, parents=True, exist_ok=True)
    wrapper_path = local_bin / "codex"
    wrapper_content = """#!/usr/bin/env bash
# AI Session Manager - Dynamic Codex profile wrapper

CURRENT_PROFILE="$HOME/.local/share/ai-session-manager/codex/current"
REAL_CODEX="$HOME/.codex/packages/standalone/current/bin/codex"

if [ -z "$CODEX_HOME" ] && [ -e "$CURRENT_PROFILE" ]; then
    export CODEX_HOME="$CURRENT_PROFILE"
fi

if [ ! -x "$REAL_CODEX" ]; then
    for candidate in "/usr/lib/chatgpt/resources/codex" "/usr/bin/codex" "/usr/local/bin/codex"; do
        if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
            REAL_CODEX="$candidate"
            break
        fi
    done
fi

exec "$REAL_CODEX" "$@"
"""
    try:
        if not wrapper_path.is_file() or wrapper_path.is_symlink() or "AI Session Manager" not in wrapper_path.read_text(encoding="utf-8", errors="ignore"):
            if wrapper_path.is_symlink() or wrapper_path.exists():
                wrapper_path.unlink()
            wrapper_path.write_text(wrapper_content, encoding="utf-8")
            wrapper_path.chmod(0o755)
    except OSError:
        pass

def sync_active_profile(data, item):
    ensure_cli_wrapper()
    data["activeId"] = item["id"]
    if item["provider"] == "codex":
        data["activeCodexId"] = item["id"]
        home = DATA / "codex" / item["id"]
        home.mkdir(mode=0o700, parents=True, exist_ok=True)
        current = DATA / "codex" / "current"
        try:
            if current.is_symlink() or current.exists():
                current.unlink()
            current.symlink_to(home)
        except OSError:
            pass

        base_config = Path.home() / ".codex" / "config.toml"
        profile_config = home / "config.toml"
        if base_config.is_file() and not profile_config.is_file():
            try:
                shutil.copy2(base_config, profile_config)
            except OSError:
                pass

        source_auth = home / "auth.json"
        if source_auth.is_file():
            target_codex = Path.home() / ".codex"
            target_codex.mkdir(mode=0o700, parents=True, exist_ok=True)
            target_auth = target_codex / "auth.json"
            try:
                shutil.copy2(source_auth, target_auth)
            except OSError:
                pass
    save(data)

def status(data):
    ensure_cli_wrapper()
    active_codex_id = data.get("activeCodexId") or (data.get("activeId") if str(data.get("activeId", "")).startswith("codex") else "codex-1")
    current_symlink = DATA / "codex" / "current"
    active_target = DATA / "codex" / active_codex_id
    if active_target.is_dir() and (not current_symlink.is_symlink() or not current_symlink.exists() or current_symlink.resolve() != active_target.resolve()):
        try:
            if current_symlink.is_symlink() or current_symlink.exists(): current_symlink.unlink()
            current_symlink.symlink_to(active_target)
        except OSError: pass

    cached = load_cache()
    output = []
    for item in data["sessions"]:
        result = dict(item); result["active"] = item["id"] == data.get("activeId")
        if item["provider"] == "codex": result["authenticated"] = (DATA / "codex" / item["id"] / "auth.json").is_file()
        else: result["authenticated"] = AGY_TOKEN.is_file()
        result["usage"] = cached.get(item["id"], {"status": "Actualizando límites…", "limits": [], "resetCredits": []})
        output.append(result)
    print(json.dumps({"activeId": data.get("activeId"), "activeCodexId": active_codex_id, "sessions": output}, separators=(",", ":")))

def refresh_usage(data):
    cached = load_cache()
    for item in data["sessions"]:
        fresh = codex_usage(item)
        if item["provider"] == "agy" and not fresh.get("limits"):
            previous = cached.get(item["id"], {})
            # A closed CLI means the local API is absent, not that the last
            # successful quota snapshot became invalid. Preserve it and mark
            # it as stale so the UI never presents it as a live value.
            if previous.get("limits"):
                fresh = dict(previous)
                fresh["stale"] = True
                fresh["source"] = "cache"
        else:
            fresh["stale"] = False
            fresh.setdefault("updatedAt", int(time.time() * 1000))
        cached[item["id"]] = fresh
    save_cache(cached)

parser = argparse.ArgumentParser(); sub = parser.add_subparsers(dest="action", required=True)
sub.add_parser("status").add_argument("--json", action="store_true")
sub.add_parser("refresh")
consume = sub.add_parser("consume-reset"); consume.add_argument("id"); consume.add_argument("credit")
for name in ("select", "login", "launch"): sub.add_parser(name).add_argument("id")
rename = sub.add_parser("rename"); rename.add_argument("id"); rename.add_argument("label")
args = parser.parse_args(); data = load()
if args.action == "status": status(data)
elif args.action == "refresh": refresh_usage(data)
elif args.action == "consume-reset": consume_reset(session(data, args.id), args.credit)
elif args.action == "rename":
    value = args.label.strip()
    if not value or len(value) > 32: raise SystemExit("Label must contain 1-32 characters")
    session(data, args.id)["label"] = value; save(data)
elif args.action == "select":
    item = session(data, args.id)
    sync_active_profile(data, item)
else:
    item = session(data, args.id)
    sync_active_profile(data, item)
    cmd, env = command(item, args.action == "login")
    os.execvpe(cmd[0], cmd, env)
